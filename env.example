# ==================== REQUIRED ====================

# Neon PostgreSQL connection string (pooled recommended)
# Get it from: https://console.neon.tech → Project → Connection Details
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Optional: Unpooled connection (for migrations if needed)
# DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# NextAuth / Auth secret (generate a long random string)
# You can use: openssl rand -base64 32
AUTH_SECRET="change-this-to-a-long-random-secret-at-least-32-chars"
NEXTAUTH_SECRET="change-this-to-a-long-random-secret-at-least-32-chars"

# Public URL of your deployed app (no trailing slash)
# Example: https://startup-expo-2026.vercel.app
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ==================== EMAIL (Resend) ====================

# Get API key from: https://resend.com/api-keys
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Verified sender (must be a domain you verified in Resend, or use onboarding@resend.dev for testing)
RESEND_FROM_EMAIL="Startup Expo <onboarding@resend.dev>"
RESEND_FROM_NAME="Startup Expo 2026"

# ==================== IMAGE STORAGE (Vercel Blob) ====================

# Automatically available when you enable Vercel Blob in your Vercel project
# Or create a token at: https://vercel.com/dashboard → Storage → Blob
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ==================== CRON SECURITY ====================

# Random secret to protect the cron endpoint
# Generate with: openssl rand -base64 24
CRON_SECRET="change-this-cron-secret"

# ==================== OPTIONAL ====================

# Node environment
NODE_ENV="production"
